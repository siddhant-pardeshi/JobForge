{
  "manifest_version": 3,
  "name": "JobForge Helper",
  "version": "1.0.0",
  "description": "Capture any job posting into your JobForge cockpit with one click, and prefill application forms from your approved answers. You always press submit.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:8787/*", "http://127.0.0.1:8787/*"],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "action": { "default_title": "JobForge Helper", "default_popup": "options.html" },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://www.naukri.com/*",
        "https://www.naukri.com/job-listings-*",
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.eu.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://jobs.smartrecruiters.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://mail.google.com/*",
        "https://outlook.office.com/mail/*",
        "https://outlook.office365.com/mail/*",
        "https://outlook.live.com/mail/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
