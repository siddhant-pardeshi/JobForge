# JobForge sample configuration. Copy to .env if you want to override defaults.
# Everything below is optional. API keys are normally stored through the
# Settings screen inside the app and never leave your machine except to call
# the provider you configured.

# Port for the backend server (default 8787)
PORT=8787

# Optional environment fallbacks for the AI provider, handy for headless setups.
# The Settings screen takes priority over these values.
# JOBFORCE_LLM_PROVIDER=openai
# JOBFORCE_LLM_API_KEY=sk-your-key-here
# JOBFORCE_LLM_MODEL=gpt-4o-mini
